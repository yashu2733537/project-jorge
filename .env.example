# ---- AI (OpenCode Zen, OpenAI-compatible API) ----
# Get a free API key at https://opencode.ai (works with any OpenAI-compatible endpoint too)
AI_BASE_URL=https://opencode.ai/zen/v1
AI_API_KEY=your_api_key_here
AI_MODEL=laguna-s-2.1-free

# ---- Gmail SMTP (needed for the email feature) ----
# App Password (NOT your normal password): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
SMTP_NAME=Your Name

# ---- Discord bot (optional) ----
# DISCORD_TOKEN=your_bot_token            # from discord.com/developers
# DISCORD_OWNER_ID=your_discord_user_id   # owner-only commands & brain actions

# ---- Telegram bot (optional) ----
# Get a token from @BotFather: https://t.me/BotFather → /newbot
# TELEGRAM_TOKEN=your_bot_token
# TELEGRAM_OWNER_ID=your_telegram_user_id  # optional owner lock (get id from @userinfobot)